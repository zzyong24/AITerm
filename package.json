{
  "name": "aiterm",
  "version": "0.1.0",
  "description": "多终端管理器 - 基于 Electron + Vue",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "node server/index.mjs",
    "build": "vite build && rm -rf dist-electron && tsc -p tsconfig.electron.json",
    "build:frontend": "vite build",
    "build:electron": "rm -rf dist-electron && tsc -p tsconfig.electron.json",
    "build:mac": "vite build && rm -rf dist-electron && tsc -p tsconfig.electron.json && electron-builder --mac",
    "build:win": "vite build && rm -rf dist-electron && tsc -p tsconfig.electron.json && electron-builder --win",
    "start": "node dist-server/index.js",
    "electron": "electron .",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.aiterm.app",
    "productName": "AITerm",
    "icon": "icon.icns",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/**/*",
      "!server/**/*.ts"
    ],
    "asarUnpack": [
      "dist/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/@xterm/**/*"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ant-design-vue": "^4.2.6",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "electron-log": "^5.4.3",
    "express": "^4.21.2",
    "marked": "^18.0.2",
    "mermaid": "^11.14.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.59.1",
    "simple-git": "^3.27.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.59.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.2",
    "electron": "^33.4.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.2",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.4",
    "vue-tsc": "^2.2.0"
  }
}
